# Institutional Authentication & Access Credentials Template
# Copy this file to .streamlit/secrets.toml and configure your credentials

[auth]
username = "admin"
password = "password"
admin_username = "manoj"
admin_password = "password123"
session_secret = "your_custom_hmac_sha256_session_secret_key"

[sms]
# Supported SMS Gateway Providers: "fast2sms", "2factor", "twilio", or "telegram"
provider = "fast2sms"
api_key = "" # Fast2SMS / 2Factor API Key

# If using Twilio:
twilio_account_sid = ""
twilio_auth_token = ""
twilio_from_number = ""
